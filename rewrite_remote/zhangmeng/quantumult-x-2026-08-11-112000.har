4.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s3\/equip\/2024.png\",\"planID\":\"1\",\"synthesis1\":\"0\",\"synthesis2\":\"0\",\"tftEquipId\":\"2195\",\"type\":\"特殊装备\"},\"2196\":{\"basicDesc\":\"+15%攻击速度 +200生命上限\",\"desc\":\"+15%攻击速度 +200生命上限\\n\\n攻击对目标和目标后面的敌人，造成基于携带者最大生命值5%的魔法伤害\",\"fetterID\":\"\",\"icon\":\"2014\",\"name\":\"巨型九头蛇\",\"picture\":\"s3\/equip\/2014.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s3\/equip\/2014.png\",\"planID\":\"1\",\"synthesis1\":\"0\",\"synthesis2\":\"0\",\"tftEquipId\":\"2196\",\"type\":\"特殊装备\"},\"2197\":{\"basicDesc\":\"+15%攻击速度 +25魔法抗性\",\"desc\":\"+15%攻击速度 +25魔法抗性\\n\\n普通攻击有20%使敌人缩小1星，效果持续10秒（最多减少1星）\",\"fetterID\":\"\",\"icon\":\"2013\",\"name\":\"降星之刀\",\"picture\":\"s3\/equip\/2013.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s3\/equip\/2013.png\",\"planID\":\"1\",\"synthesis1\":\"0\",\"synthesis2\":\"0\",\"tftEquipId\":\"2197\",\"type\":\"特殊装备\"},\"2198\":{\"basicDesc\":\"+15攻击力 +15%攻击速度\",\"desc\":\"+15攻击力 +15%攻击速度\\n\\n每秒钟佩戴者有15%的几率获得100%的暴击\",\"fetterID\":\"\",\"icon\":\"2002\",\"name\":\"神圣之刃\",\"picture\":\"s3\/equip\/2002.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s3\/equip\/2002.png\",\"planID\":\"1\",\"synthesis1\":\"0\",\"synthesis2\":\"0\",\"tftEquipId\":\"2198\",\"type\":\"特殊装备\"},\"2199\":{\"basicDesc\":\"+15%攻击速度 +25护甲\",\"desc\":\"+15%攻击速度 +25护甲\\n\\n装备者闪避所有暴击攻击（包含来自技能的暴击伤害）[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2012\",\"name\":\"幻影之舞\",\"picture\":\"s3\/equip\/2012.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s3\/equip\/2012.png\",\"planID\":\"1\",\"synthesis1\":\"0\",\"synthesis2\":\"0\",\"tftEquipId\":\"2199\",\"type\":\"特殊装备\"},\"2200\":{\"basicDesc\":\"+20%法术强度 +20法力值\",\"desc\":\"+20%法术强度 +20法力值\\n\\n技能命中时对目标附近3个单位造成180魔法伤害，会对被控制的目标造成额外的180点魔法伤害\",\"fetterID\":\"\",\"icon\":\"2200\",\"name\":\"卢登的回声\",\"picture\":\"s3\/equip\/2200.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s3\/equip\/2200.png\",\"planID\":\"1\",\"synthesis1\":\"0\",\"synthesis2\":\"0\",\"tftEquipId\":\"2200\",\"type\":\"特殊装备\"},\"2601\":{\"basicDesc\":\"+10攻击力 +75%暴击率\",\"desc\":\"+10攻击力 +75%暴击率\\n\\n提供75%暴击几率(包含基础装备)和10%暴击伤害，会将持有者溢出的每1%暴击几率转化为1%暴击伤害。[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2001\",\"name\":\"无尽之刃\",\"picture\":\"s4\/equip\/2001.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2001.png\",\"planID\":\"6\",\"synthesis1\":\"1601\",\"synthesis2\":\"1609\",\"tftEquipId\":\"535\",\"type\":\"成型装备\"},\"2603\":{\"basicDesc\":\"+10攻击力 +10%法术强度\",\"desc\":\"+10攻击力 +10%法术强度\\n\\n来自携带者的技能的魔法伤害和真实伤害会治疗携带者，治疗量相当于33%的技能造成伤害。携带者还会对生命值最低的友军提供等额的治疗效果。\",\"fetterID\":\"\",\"icon\":\"2003\",\"name\":\"海克斯科技枪刃\",\"picture\":\"s4\/equip\/2003.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2003.png\",\"planID\":\"6\",\"synthesis1\":\"1601\",\"synthesis2\":\"1603\",\"tftEquipId\":\"523\",\"type\":\"成型装备\"},\"2604\":{\"basicDesc\":\"+10攻击力 +15法力值\",\"desc\":\"+10攻击力 +15法力值\\n\\n携带者每次普通攻击时额外回复8法力。\",\"fetterID\":\"\",\"icon\":\"2004\",\"name\":\"朔极之矛\",\"picture\":\"s4\/equip\/2004.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2004.png\",\"planID\":\"6\",\"synthesis1\":\"1601\",\"synthesis2\":\"1604\",\"tftEquipId\":\"525\",\"type\":\"成型装备\"},\"2605\":{\"basicDesc\":\"+10攻击力 +20护甲\",\"desc\":\"+10攻击力 +20护甲\\n\\n当携带者的生命值首次跌到60%以下时，会暂时进入潜行状态，变得无法被选取并移除所有负面效果。在从潜行状态中出来后，携带者获得+40%攻击速度。[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2005\",\"name\":\"夜之锋刃\",\"picture\":\"s4\/equip\/2005.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2005.png\",\"planID\":\"6\",\"synthesis1\":\"1601\",\"synthesis2\":\"1605\",\"tftEquipId\":\"6022\",\"type\":\"成型装备\"},\"2606\":{\"basicDesc\":\"+10攻击力 +20魔法抗性\",\"desc\":\"+10攻击力 +20魔法抗性\\n\\n携带者的物理伤害会治疗自身，治疗量相当于33%的实际伤害值。如果携带者生命值跌到40%以下，则会获得相当于30%最大生命值的护盾值，最多持续5秒。\",\"fetterID\":\"\",\"icon\":\"2006\",\"name\":\"汲取剑\",\"picture\":\"s4\/equip\/2006.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2006.png\",\"planID\":\"6\",\"synthesis1\":\"1601\",\"synthesis2\":\"1606\",\"tftEquipId\":\"529\",\"type\":\"成型装备\"},\"2607\":{\"basicDesc\":\"+10攻击力 +150生命上限\",\"desc\":\"+10攻击力 +150生命上限\\n\\n在战斗环节开始时，携带者和站在同一排1格内的友军获得+30%攻击速度，持续至本回合战斗环节结束。\",\"fetterID\":\"\",\"icon\":\"2007\",\"name\":\"基克的先驱\",\"picture\":\"s4\/equip\/2007.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2007.png\",\"planID\":\"6\",\"synthesis1\":\"1601\",\"synthesis2\":\"1607\",\"tftEquipId\":\"531\",\"type\":\"成型装备\"},\"2609\":{\"basicDesc\":\"+55%攻击速度\",\"desc\":\"+55%攻击速度\\n\\n使携带者的攻击距离提升1格并提供55%额外攻击速度（包括基础装备）。携带者的普通攻击不会再未命中。\",\"fetterID\":\"\",\"icon\":\"2009\",\"name\":\"疾射火炮\",\"picture\":\"s4\/equip\/2009.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2009.png\",\"planID\":\"6\",\"synthesis1\":\"1602\",\"synthesis2\":\"1602\",\"tftEquipId\":\"537\",\"type\":\"成型装备\"},\"2610\":{\"basicDesc\":\"+10%攻击速度 +10%法术强度\",\"desc\":\"+10%攻击速度 +10%法术强度\\n\\n攻击提供+6%额外攻击速度，持续到战斗结束为止。这个效果可以叠加任意层数。\",\"fetterID\":\"\",\"icon\":\"2010\",\"name\":\"鬼索的狂暴之刃\",\"picture\":\"s4\/equip\/2010.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2010.png\",\"planID\":\"6\",\"synthesis1\":\"1602\",\"synthesis2\":\"1603\",\"tftEquipId\":\"539\",\"type\":\"成型装备\"},\"2611\":{\"basicDesc\":\"+20%攻击速度 +15法力值\",\"desc\":\"+20%攻击速度 +15法力值\\n\\n携带者获得10%攻击速度。携带者的每第3次攻击会释放一道链状闪电，可弹射4名敌人，造成60魔法伤害并使目标的魔法抗性降低50%，持续5秒。\",\"fetterID\":\"\",\"icon\":\"2011\",\"name\":\"斯塔缇克电刃\",\"picture\":\"s4\/equip\/2011.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2011.png\",\"planID\":\"6\",\"synthesis1\":\"1602\",\"synthesis2\":\"1604\",\"tftEquipId\":\"541\",\"type\":\"成型装备\"},\"2612\":{\"basicDesc\":\"+10%攻击速度 +20护甲\",\"desc\":\"+10%攻击速度 +20护甲\\n\\n当携带者攻击或受到伤害时，获得可叠加的2攻击力和法术强度。这个效果最多叠加25次，且叠满后携带者会获得25护甲和魔法抗性。\",\"fetterID\":\"\",\"icon\":\"2052\",\"name\":\"泰坦的坚决\",\"picture\":\"s4\/equip\/2052.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2052.png\",\"planID\":\"6\",\"synthesis1\":\"1602\",\"synthesis2\":\"1605\",\"tftEquipId\":\"543\",\"type\":\"成型装备\"},\"2613\":{\"basicDesc\":\"+10%攻击速度 +20魔法抗性 +10攻击力\",\"desc\":\"+10%攻击速度 +20魔法抗性 +10攻击力\\n\\n携带者获得10攻击力。携带者的攻击会对附近的另一名敌人发射一个额外的弹体，造成携带者70%攻击力的物理伤害。\",\"fetterID\":\"\",\"icon\":\"2033\",\"name\":\"卢安娜的飓风\",\"picture\":\"s4\/equip\/2033.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2033.png\",\"planID\":\"6\",\"synthesis1\":\"1602\",\"synthesis2\":\"1606\",\"tftEquipId\":\"545\",\"type\":\"成型装备\"},\"2614\":{\"basicDesc\":\"+10%攻击速度 +150生命上限\",\"desc\":\"+10%攻击速度 +150生命上限\\n\\n在战斗环节开始时，携带者会嘲讽4格内的敌人们。当携带者阵亡时，一个【虚空生物】会爬起来嘲讽附近的敌人。召唤物召唤的【虚空生物】只有25%强度。\",\"fetterID\":\"\",\"icon\":\"2214\",\"name\":\"兹若特传送门\",\"picture\":\"s4\/equip\/2214.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2214.png\",\"planID\":\"6\",\"synthesis1\":\"1602\",\"synthesis2\":\"1607\",\"tftEquipId\":\"547\",\"type\":\"成型装备\"},\"2616\":{\"basicDesc\":\"+75%法术强度\",\"desc\":\"+75%法术强度\\n\\n提供75额外法术强度（包含基础装备）。\",\"fetterID\":\"\",\"icon\":\"2016\",\"name\":\"班克斯的魔法帽\",\"picture\":\"s4\/equip\/2016.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2016.png\",\"planID\":\"6\",\"synthesis1\":\"1603\",\"synthesis2\":\"1603\",\"tftEquipId\":\"553\",\"type\":\"成型装备\"},\"2617\":{\"basicDesc\":\"+10%法术强度 +15法力值\",\"desc\":\"+10%法术强度 +15法力值\\n\\n在战斗中，持有者每5秒获得25点法术强度。\",\"fetterID\":\"\",\"icon\":\"2017\",\"name\":\"大天使之杖\",\"picture\":\"s4\/equip\/2017.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2017.png\",\"planID\":\"6\",\"synthesis1\":\"1603\",\"synthesis2\":\"1604\",\"tftEquipId\":\"555\",\"type\":\"成型装备\"},\"2618\":{\"basicDesc\":\"+10%法术强度 +20护甲\",\"desc\":\"+10%法术强度 +20护甲\\n\\n战斗开始时，为同一排2格内的友军提供300\/350\/400生命值的护盾(随携带者的等级成长)，持续15秒。\",\"fetterID\":\"\",\"icon\":\"2018\",\"name\":\"钢铁烈阳之匣\",\"picture\":\"s4\/equip\/2018.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2018.png\",\"planID\":\"6\",\"synthesis1\":\"1603\",\"synthesis2\":\"1605\",\"tftEquipId\":\"557\",\"type\":\"成型装备\"},\"2619\":{\"basicDesc\":\"+10%法术强度 +20魔法抗性\",\"desc\":\"+10%法术强度 +20魔法抗性\\n\\n降低周围2格范围内的敌人50%的魔抗，同时2格内的敌人在施放技能时会被震击，受到相当于其200%最大法力值的魔法伤害。\",\"fetterID\":\"\",\"icon\":\"2019\",\"name\":\"离子火花\",\"picture\":\"s4\/equip\/2019.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2019.png\",\"planID\":\"6\",\"synthesis1\":\"1603\",\"synthesis2\":\"1606\",\"tftEquipId\":\"559\",\"type\":\"成型装备\"},\"2620\":{\"basicDesc\":\"+10%法术强度 +150生命上限\",\"desc\":\"+10%法术强度 +150生命上限\\n\\n在携带者用技能造成魔法伤害或真实伤害时，会燃烧目标，在10秒里持续造成真实伤害，总额相当于目标20%的最大生命值，并在燃烧期间阻止50%治疗效果。[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2020\",\"name\":\"莫雷洛秘典\",\"picture\":\"s4\/equip\/2020.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2020.png\",\"planID\":\"6\",\"synthesis1\":\"1603\",\"synthesis2\":\"1607\",\"tftEquipId\":\"561\",\"type\":\"成型装备\"},\"2622\":{\"basicDesc\":\"+50法力值\",\"desc\":\"+50法力值\\n\\n在携带者施放技能后，携带者会回复20法力值。[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2222\",\"name\":\"蓝霸符\",\"picture\":\"s4\/equip\/2222.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2222.png\",\"planID\":\"6\",\"synthesis1\":\"1604\",\"synthesis2\":\"1604\",\"tftEquipId\":\"567\",\"type\":\"成型装备\"},\"2623\":{\"basicDesc\":\"+15法力值 +20护甲\",\"desc\":\"+15法力值 +20护甲\\n\\n使2格内敌人的攻击速度降低35%。[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2023\",\"name\":\"冰霜之心\",\"picture\":\"s4\/equip\/2023.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2023.png\",\"planID\":\"6\",\"synthesis1\":\"1604\",\"synthesis2\":\"1605\",\"tftEquipId\":\"569\",\"type\":\"成型装备\"},\"2624\":{\"basicDesc\":\"+15法力值 +20魔法抗性\",\"desc\":\"+15法力值 +20魔法抗性\\n\\n战斗环节开始时，携带者和站在同一排1格内的所有友军获得30法术强度，持续至战斗环节结束为止。\",\"fetterID\":\"\",\"icon\":\"2124\",\"name\":\"能量圣杯\",\"picture\":\"s4\/equip\/2124.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2124.png\",\"planID\":\"6\",\"synthesis1\":\"1604\",\"synthesis2\":\"1606\",\"tftEquipId\":\"571\",\"type\":\"成型装备\"},\"2625\":{\"basicDesc\":\"+15法力值 +150生命上限\",\"desc\":\"+15法力值 +150生命上限\\n\\n每过5秒，携带者为1格内的友军们散发出一个光环，治疗他们18%的已损失生命值。受光环影响的友军们还会降低所受的来自群体目标技能和攻击的25%伤害，持续5秒。\",\"fetterID\":\"\",\"icon\":\"2025\",\"name\":\"救赎\",\"picture\":\"s4\/equip\/2025.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2025.png\",\"planID\":\"6\",\"synthesis1\":\"1604\",\"synthesis2\":\"1607\",\"tftEquipId\":\"573\",\"type\":\"成型装备\"},\"2627\":{\"basicDesc\":\"+70护甲\",\"desc\":\"+70护甲\\n\\n提供70额外护甲（包含基础装备）。使所受暴击的75%额外伤害变得无效。在被一次攻击命中时，对附近的所有敌人造成75\/100\/150★魔法伤害(每2.5秒一次)。\",\"fetterID\":\"\",\"icon\":\"2054\",\"name\":\"棘刺背心\",\"picture\":\"s4\/equip\/2054.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2054.png\",\"planID\":\"6\",\"synthesis1\":\"1605\",\"synthesis2\":\"1605\",\"tftEquipId\":\"579\",\"type\":\"成型装备\"},\"2628\":{\"basicDesc\":\"+20护甲 +20魔法抗性\",\"desc\":\"+20护甲 +20魔法抗性\\n\\n携带者每成为一名敌人的目标，就会获得18护甲和18魔法抗性。\",\"fetterID\":\"\",\"icon\":\"2248\",\"name\":\"石像鬼石板甲\",\"picture\":\"s4\/equip\/2248.png\",\"fullPicture\":\"https:\/\/game.gtimg.cn\/images\/lol\/act\/jkzlk\/s4\/equip\/2248.png\",\"planID\":\"6\",\"synthesis1\":\"1605\",\"synthesis2\":\"1606\",\"tftEquipId\":\"581\",\"type\":\"成型装备\"},\"2629\":{\"basicDesc\":\"+20护甲 +150生命上限\",\"desc\":\"+20护甲 +150生命上限\\n\\n每2秒灼烧2格内随机一名敌方英雄，在8秒里造成真实伤害，总额相当于16%最大生命值，该敌人受到的所有治疗效果降低50%。[唯一- 每位英雄仅可装备一件]\",\"fetterID\":\"\",\"icon\":\"2329\",\"name\